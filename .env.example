# ==============================================================================
# DEVEVOKE — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env.local pour le développement local :
#   cp .env.example .env.local
# Ne committez jamais vos fichiers .env ou .env.local contenant de vraies clés.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVOI D'E-MAILS TRANSACTIONNELS (Resend — Transport principal)
# ------------------------------------------------------------------------------
# Clé API secrète Resend (https://resend.com/api-keys)
# Laissez 're_placeholder' ou vide en local pour activer le mode simulation (mock).
RESEND_API_KEY=re_placeholder

# Identité d'expédition et adresse de réception interne des formulaires
EMAIL_FROM_NAME=DevEvoke
EMAIL_FROM_ADDRESS=noreply@devevoke.com
DEVOKE_CONTACT_EMAIL=contact@devevoke.com

# ------------------------------------------------------------------------------
# 2. VÉRIFICATION DES E-MAILS PROFESSIONNELS B2B (Hunter Email Verifier)
# ------------------------------------------------------------------------------
# Clé API secrète serveur Hunter (https://hunter.io/api-keys)
HUNTER_API_KEY=
HUNTER_EMAIL_VERIFICATION_ENABLED=true
HUNTER_EMAIL_VERIFICATION_TIMEOUT_MS=10000
HUNTER_MIN_SCORE=80
HUNTER_ALLOW_ACCEPT_ALL=false

# ------------------------------------------------------------------------------
# 3. TRANSPORT SMTP DE SECOURS (Fallback Nodemailer si Resend n'est pas configuré)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@devevoke.com
SMTP_PASS=votre_mot_de_passe_smtp_securise

# ------------------------------------------------------------------------------
# 4. SÉCURITÉ & ANALYTICS
# ------------------------------------------------------------------------------
# Mettre à 'true' uniquement lors de l'exécution de tests automatisés intensifs
RATE_LIMIT_DISABLED=false

# Identifiant Google Analytics 4 (chargé dans src/app/layout.tsx)
GA_TRACKING_ID=G-XXXXXXXXXX

# URL canonique publique du site (utilisée pour metadataBase, canonicals, sitemap, JSON-LD, og:url)
NEXT_PUBLIC_SITE_URL=https://www.devevoke.com
